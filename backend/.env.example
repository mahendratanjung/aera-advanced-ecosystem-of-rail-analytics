# Copy to .env. Everything is optional; defaults run fully local with the simulator.

# Signing secret for dev auth tokens. Change it for any shared deployment.
AERA_JWT_SECRET=dev-only-change-me
# Dev account passwords (admin@aera.dev, operator@aera.dev, operator.kls@aera.dev)
AERA_ADMIN_PASSWORD=aera-admin
AERA_OPERATOR_PASSWORD=aera-operator

# Comma separated browser origins allowed to call the API
AERA_CORS_ORIGINS=http://localhost:3000

# Simulation start: "now" or a Kuala Lumpur time such as "17:30"
AERA_SIM_START=now

# Real MQTT broker. Leave empty to use the in-process bus.
# Example: mqtts://user:pass@broker.example.com:8883  or  wss://user:pass@broker.example.com:443/mqtt
AERA_MQTT_URL=
# Optional shared token required by the HTTP ingest bridge (header X-Ingest-Token)
AERA_INGEST_TOKEN=

# Ask AERA chatbot through OpenRouter (https://openrouter.ai/keys). Leave empty to turn the chatbot off;
# the route advisor still works. Any model id works; "openrouter/free" picks a free model with tool support.
AERA_OPENROUTER_API_KEY=
AERA_OPENROUTER_MODEL=openrouter/free

# GTFS Realtime vehicle positions for the line. data.gov.my has none for Rapid Rail yet; the twin
# keeps checking and uses the feed once it exists. Leave empty to stop checking.
AERA_GTFS_RT_URL=https://api.data.gov.my/gtfs-realtime/vehicle-position/prasarana?category=rapid-rail-kl
