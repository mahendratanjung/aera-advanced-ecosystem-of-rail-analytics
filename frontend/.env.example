# Twin service base URL. The WebSocket URL is derived from it.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Mapbox public token (pk.…) for the 3D basemap (trees, landmarks, day/night lighting).
# Free up to 50,000 map loads a month. Leave empty to use the free Carto basemap instead.
NEXT_PUBLIC_MAPBOX_TOKEN=
